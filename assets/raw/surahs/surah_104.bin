{"id":104,"name":"الهمزة","transliteration":"Al-Humazah","translation_fr":"Les calomniateurs","translation_en":"The Traducer","type":"meccan","total_verses":9,"verses":[{"id":1,"text":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ","translation_fr":"Malheur à tout calomniateur diffamateur","translation_en":"Woe to every scorner and mocker","transliteration":"Waylun likulli humazatin lumazatin"},{"id":2,"text":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ","translation_fr":"qui amasse une fortune et la compte","translation_en":"Who collects wealth and [continuously] counts it","transliteration":"Allathee jamaAAa malan waAAaddadahu"},{"id":3,"text":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","translation_fr":"pensant que sa fortune l'immortalisera","translation_en":"He thinks that his wealth will make him immortal","transliteration":"Yahsabu anna malahu akhladahu"},{"id":4,"text":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","translation_fr":"Mais non! Il sera certes, jeté dans la Hutamah","translation_en":"No! He will surely be thrown into the Crusher","transliteration":"Kalla layunbathanna fee alhutamati"},{"id":5,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","translation_fr":"Et qui te dira ce qu'est la Hutamah","translation_en":"And what can make you know what is the Crusher","transliteration":"Wama adraka ma alhutamatu"},{"id":6,"text":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","translation_fr":"Le Feu attisé d'Allah","translation_en":"It is the fire of Allah, [eternally] fueled","transliteration":"Naru Allahi almooqadatu"},{"id":7,"text":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","translation_fr":"qui monte jusqu'aux cœurs","translation_en":"Which mounts directed at the hearts","transliteration":"Allatee tattaliAAu AAala alafidati"},{"id":8,"text":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ","translation_fr":"Il se refermera sur eux","translation_en":"Indeed, Hellfire will be closed down upon them","transliteration":"lnnaha AAalayhim musadatun"},{"id":9,"text":"فِي عَمَدٖ مُّمَدَّدَةِۭ","translation_fr":"en colonnes (de flammes) étendues","translation_en":"In extended columns","transliteration":"Fee AAamadin mumaddadatin"}]}