{"id":112,"name":"الإخلاص","transliteration":"Al-Ikhlas","translation_fr":"La sincérité","translation_en":"The Sincerity","type":"meccan","total_verses":4,"verses":[{"id":1,"text":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","translation_fr":"Dis: «Il est Allah, Unique","translation_en":"Say, \"He is Allah, [who is] One","transliteration":"Qul huwa Allahu ahadun"},{"id":2,"text":"ٱللَّهُ ٱلصَّمَدُ","translation_fr":"Allah, Le Seul à être imploré pour ce que nous désirons","translation_en":"Allah, the Eternal Refuge","transliteration":"Allahu alssamadu"},{"id":3,"text":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","translation_fr":"Il n'a jamais engendré, n'a pas été engendré non plus","translation_en":"He neither begets nor is born","transliteration":"Lam yalid walam yooladu"},{"id":4,"text":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","translation_fr":"Et nul n'est égal à Lui»","translation_en":"Nor is there to Him any equivalent","transliteration":"Walam yakun lahu kufuwan ahadun"}]}