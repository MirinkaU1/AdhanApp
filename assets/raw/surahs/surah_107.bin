{"id":107,"name":"الماعون","transliteration":"Al-Ma'un","translation_fr":"L'entraide","translation_en":"The Small kindnesses","type":"meccan","total_verses":7,"verses":[{"id":1,"text":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","translation_fr":"Vois-tu celui qui traite de mensonge la Rétribution","translation_en":"Have you seen the one who denies the Recompense","transliteration":"Araayta allathee yukaththibu bialddeeni"},{"id":2,"text":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","translation_fr":"C'est bien lui qui repousse l'orphelin","translation_en":"For that is the one who drives away the orphan","transliteration":"Fathalika allathee yaduAAAAu alyateema"},{"id":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","translation_fr":"et qui n'encourage point à nourrir le pauvre","translation_en":"And does not encourage the feeding of the poor","transliteration":"Wala yahuddu AAala taAAami almiskeeni"},{"id":4,"text":"فَوَيۡلٞ لِّلۡمُصَلِّينَ","translation_fr":"Malheur donc, à ceux qui prient","translation_en":"So woe to those who pray","transliteration":"Fawaylun lilmusalleena"},{"id":5,"text":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","translation_fr":"tout en négligeant (et retardant) leur Salât","translation_en":"[But] who are heedless of their prayer","transliteration":"Allatheena hum AAan salatihim sahoona"},{"id":6,"text":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","translation_fr":"qui sont pleins d'ostentation","translation_en":"Those who make show [of their deeds]","transliteration":"Allatheena hum yuraoona"},{"id":7,"text":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","translation_fr":"et refusent l'ustensile (à celui qui en a besoin)","translation_en":"And withhold [simple] assistance","transliteration":"WayamnaAAoona almaAAoona"}]}